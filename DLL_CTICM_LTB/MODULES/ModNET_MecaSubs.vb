    '=======================================================================================
    ' ROUTINE DE CALCUL DE LA MATRICE LINEAIRE
    '=======================================================================================

    Sub MatSA(ByRef E As Double, ByRef G As Double, ByRef L As Double, ByRef zC As Double, ByRef zCp As Double,
              ByRef zCs As Double, ByRef Iz As Double, ByRef It As Double, ByRef Iw As Double,
              ByRef TaperEffect As Boolean, ByRef Ipsi As Double, ByRef Iwpsi As Double, ByRef Ipsiy As Double,
              ByRef Izzx2 As Double, ByRef Iz2zx As Double, ByRef Iy As Double,
              ByRef Izx As Double, ByRef Izx2 As Double, ByRef Izzx As Double,
              ByRef C() As Double, ByRef SA() As Double)

        'C(8) matrice des ressorts  (termes de la diagonale seulement)

        Dim K(14, 14) As Double

        Dim MATRIXINDEX As Short = 1

        Select Case MATRIXINDEX

            '   =================================================================================================================
            Case 1, 2  'YG et ABe
                '================================================================================================================

                Dim EIZL As Double
                Dim EIZL2 As Double
                Dim EIZL3 As Double
                Dim EIWL As Double
                Dim EIWL2 As Double
                Dim EIWL3 As Double

                Dim Itsave As Double = It 'avant modification éventuelle due au Taper Effect

                'MATRICE SANS LES RESSORTS
                '=========================

                EIZL = E * Iz / L
                EIZL2 = EIZL / L
                EIZL3 = EIZL2 / L
                EIWL = E * Iw / L
                EIWL2 = EIWL / L
                EIWL3 = EIWL2 / L

                'Influence du Taper Effect sur It
                If TaperEffect Then
                    It = It + E / G * Ipsi
                End If

                'K(I,J) (avec 7dof dont on ne garde que 4)

                K(2, 2) = 12 * EIZL3
                K(2, 4) = 0
                K(2, 6) = 6 * EIZL2
                K(2, 7) = 0
                K(2, 9) = -12 * EIZL3
                K(2, 11) = 0
                K(2, 13) = 6 * EIZL2
                K(2, 14) = 0
                K(4, 4) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(4, 6) = 0
                K(4, 7) = 6 * EIWL2 + G * It / 10
                K(4, 9) = 0
                K(4, 11) = -12 * EIWL3 - 6 * G * It / 5 / L
                K(4, 13) = 0
                K(4, 14) = 6 * EIWL2 + G * It / 10
                K(6, 6) = 4 * EIZL
                K(6, 7) = 0
                K(6, 9) = -6 * EIZL2
                K(6, 11) = 0
                K(6, 13) = 2 * EIZL
                K(6, 14) = 0
                K(7, 7) = 4 * EIWL + 2 * G * It * L / 15
                K(7, 9) = 0
                K(7, 11) = -6 * EIWL2 - G * It / 10
                K(7, 13) = 0
                K(7, 14) = 2 * EIWL - L * G * It / 30
                K(9, 9) = 12 * EIZL3
                K(9, 11) = 0
                K(9, 13) = -6 * EIZL2
                K(9, 14) = 0
                K(11, 11) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(11, 13) = 0
                K(11, 14) = -6 * EIWL2 - G * It / 10
                K(13, 13) = 4 * EIZL
                K(13, 14) = 0
                K(14, 14) = 4 * EIWL + 2 * G * It * L / 15

                'Influence du Taper Effect
                If TaperEffect Then
                    'Iwpsi
                    K(7, 7) = K(7, 7) - E * Iwpsi
                    K(14, 14) = K(14, 14) + E * Iwpsi
                    'Ipsiy
                    K(2, 7) = K(2, 7) - E * Ipsiy / L
                    K(2, 14) = K(2, 14) + E * Ipsiy / L
                    K(4, 6) = K(4, 6) + E * Ipsiy / L
                    K(4, 13) = K(4, 13) - E * Ipsiy / L
                    K(6, 7) = K(6, 7) - E * Ipsiy / 2
                    K(6, 11) = K(6, 11) - E * Ipsiy / L
                    K(6, 14) = K(6, 14) + E * Ipsiy / 2
                    K(7, 9) = K(7, 9) + E * Ipsiy / L
                    K(7, 13) = K(7, 13) - E * Ipsiy / 2
                    K(9, 14) = K(9, 14) - E * Ipsiy / L
                    K(11, 13) = K(11, 13) + E * Ipsiy / L
                    K(13, 14) = K(13, 14) + E * Ipsiy / 2
                End If

                'on rétablit It après prise en compte éventuelle du Taper Effect
                It = Itsave

            Case 3  '3 : MOHRI_ABe
                '================================================================================================================

                Dim EIZL As Double
                Dim EIZL2 As Double
                Dim EIZL3 As Double
                Dim EIWL As Double
                Dim EIWL2 As Double
                Dim EIWL3 As Double

                'MATRICE SANS LES RESSORTS
                '=========================

                EIZL = E * Iz / L
                EIZL2 = EIZL / L
                EIZL3 = EIZL2 / L
                EIWL = E * Iw / L
                EIWL2 = EIWL / L
                EIWL3 = EIWL2 / L

                'K(I,J) (avec 7dof dont on ne garde que 4)

                K(2, 2) = 12 * EIZL3
                K(2, 4) = 0
                K(2, 6) = 6 * EIZL2
                K(2, 7) = 0
                K(2, 9) = -12 * EIZL3
                K(2, 11) = 0
                K(2, 13) = 6 * EIZL2
                K(2, 14) = 0
                K(4, 4) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(4, 6) = 0
                K(4, 7) = 6 * EIWL2 + G * It / 10
                K(4, 9) = 0
                K(4, 11) = -12 * EIWL3 - 6 * G * It / 5 / L
                K(4, 13) = 0
                K(4, 14) = 6 * EIWL2 + G * It / 10
                K(6, 6) = 4 * EIZL
                K(6, 7) = 0
                K(6, 9) = -6 * EIZL2
                K(6, 11) = 0
                K(6, 13) = 2 * EIZL
                K(6, 14) = 0
                K(7, 7) = 4 * EIWL + 2 * G * It * L / 15
                K(7, 9) = 0
                K(7, 11) = -6 * EIWL2 - G * It / 10
                K(7, 13) = 0
                K(7, 14) = 2 * EIWL - L * G * It / 30
                K(9, 9) = 12 * EIZL3
                K(9, 11) = 0
                K(9, 13) = -6 * EIZL2
                K(9, 14) = 0
                K(11, 11) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(11, 13) = 0
                K(11, 14) = -6 * EIWL2 - G * It / 10
                K(13, 13) = 4 * EIZL
                K(13, 14) = 0
                K(14, 14) = 4 * EIWL + 2 * G * It * L / 15

                'Termes supplémentaires de Mohri

                K(2, 7) = K(2, 7) - 2 * E * Iz * zCp / L
                K(2, 14) = K(2, 14) + 2 * E * Iz * zCp / L
                K(4, 4) = K(4, 4) - E * Iz * (180 * zC ^ 2 - 72 * L ^ 2 * zCp ^ 2) / 15 / L ^ 3
                K(4, 6) = K(4, 6) + 2 * E * Iz * zCp / L
                K(4, 7) = K(4, 7) - E * Iz * (90 * zC ^ 2 - 6 * L ^ 2 * zCp ^ 2) / 15 / L ^ 2
                K(4, 11) = K(4, 11) + E * Iz * (180 * zC ^ 2 - 72 * L ^ 2 * zCp ^ 2) / 15 / L ^ 3
                K(4, 13) = K(4, 13) - 2 * E * Iz * zCp / L
                K(4, 14) = K(4, 14) - E * Iz * (90 * zC ^ 2 - 6 * L ^ 2 * zCp ^ 2) / 15 / L ^ 2
                K(6, 7) = K(6, 7) - E * Iz * zCp
                K(6, 11) = K(6, 11) - 2 * E * Iz * zCp / L
                K(6, 14) = K(6, 14) + E * Iz * zCp
                K(7, 7) = K(7, 7) - E * Iz * (60 * zC ^ 2 - 8 * L ^ 2 * zCp ^ 2) / 15 / L
                K(7, 9) = K(7, 9) + 2 * E * Iz * zCp / L
                K(7, 11) = K(7, 11) + E * Iz * (90 * zC ^ 2 - 6 * L ^ 2 * zCp ^ 2) / 15 / L ^ 2
                K(7, 13) = K(7, 13) - E * Iz * zCp
                K(7, 14) = K(7, 14) - E * Iz * (30 * zC ^ 2 + 2 * L ^ 2 * zCp ^ 2) / 15 / L
                K(9, 14) = K(9, 14) - 2 * E * Iz * zCp / L
                K(11, 11) = K(11, 11) - E * Iz * (180 * zC ^ 2 - 72 * L ^ 2 * zCp ^ 2) / 15 / L ^ 3
                K(11, 13) = K(11, 13) + 2 * E * Iz * zCp / L
                K(11, 14) = K(11, 14) + E * Iz * (90 * zC ^ 2 - 6 * L ^ 2 * zCp ^ 2) / 15 / L ^ 2
                K(13, 14) = K(13, 14) + E * Iz * zCp
                K(14, 14) = K(14, 14) - E * Iz * (60 * zC ^ 2 - 8 * L ^ 2 * zCp ^ 2) / 15 / L

            Case 4, 5  '4 : MOHRI_YG   5 : MOHRI + v't'
                '================================================================================================================

                Dim EIZL As Double
                Dim EIZL2 As Double
                Dim EIZL3 As Double
                Dim EIWL As Double
                Dim EIWL2 As Double
                Dim EIWL3 As Double

                Dim Itsave As Double = It 'avant modification éventuelle due au Taper Effect et à la disymétrie
                It = It + 4 * zCp ^ 2 * Iz * E / G

                'MATRICE SANS LES RESSORTS
                '=========================

                EIZL = E * Iz / L
                EIZL2 = EIZL / L
                EIZL3 = EIZL2 / L
                EIWL = E * Iw / L
                EIWL2 = EIWL / L
                EIWL3 = EIWL2 / L

                'K(I,J) (avec 7dof dont on ne garde que 4)

                K(2, 2) = 12 * EIZL3
                K(2, 4) = 0
                K(2, 6) = 6 * EIZL2
                K(2, 7) = 0
                K(2, 9) = -12 * EIZL3
                K(2, 11) = 0
                K(2, 13) = 6 * EIZL2
                K(2, 14) = 0
                K(4, 4) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(4, 6) = 0
                K(4, 7) = 6 * EIWL2 + G * It / 10
                K(4, 9) = 0
                K(4, 11) = -12 * EIWL3 - 6 * G * It / 5 / L
                K(4, 13) = 0
                K(4, 14) = 6 * EIWL2 + G * It / 10
                K(6, 6) = 4 * EIZL
                K(6, 7) = 0
                K(6, 9) = -6 * EIZL2
                K(6, 11) = 0
                K(6, 13) = 2 * EIZL
                K(6, 14) = 0
                K(7, 7) = 4 * EIWL + 2 * G * It * L / 15
                K(7, 9) = 0
                K(7, 11) = -6 * EIWL2 - G * It / 10
                K(7, 13) = 0
                K(7, 14) = 2 * EIWL - L * G * It / 30
                K(9, 9) = 12 * EIZL3
                K(9, 11) = 0
                K(9, 13) = -6 * EIZL2
                K(9, 14) = 0
                K(11, 11) = 12 * EIWL3 + 6 * G * It / 5 / L
                K(11, 13) = 0
                K(11, 14) = -6 * EIWL2 - G * It / 10
                K(13, 13) = 4 * EIZL
                K(13, 14) = 0
                K(14, 14) = 4 * EIWL + 2 * G * It * L / 15

                'Termes supplémentaires de Mohri

                K(2, 7) = K(2, 7) - 2 * E * Iz * zCp / L
                K(2, 14) = K(2, 14) + 2 * E * Iz * zCp / L
                K(4, 6) = K(4, 6) + 2 * E * Iz * zCp / L
                K(4, 13) = K(4, 13) - 2 * E * Iz * zCp / L
                K(6, 7) = K(6, 7) - E * Iz * zCp
                K(6, 11) = K(6, 11) - 2 * E * Iz * zCp / L
                K(6, 14) = K(6, 14) + E * Iz * zCp
                K(7, 9) = K(7, 9) + 2 * E * Iz * zCp / L
                K(7, 13) = K(7, 13) - E * Iz * zCp
                K(9, 14) = K(9, 14) - 2 * E * Iz * zCp / L
                K(11, 13) = K(11, 13) + 2 * E * Iz * zCp / L
                K(13, 14) = K(13, 14) + E * Iz * zCp

                'on rétablit It
                It = Itsave


            Case Else '6    ABe
                '================================================================================================================

                Dim EIZL As Double
                Dim EIZL2 As Double
                Dim EIZL3 As Double
                Dim EIWL As Double
                Dim EIWL2 As Double
                Dim EIWL3 As Double

                Dim Itsave As Double = It 'avant modification éventuelle due au Taper Effect

                'MATRICE SANS LES RESSORTS
                '=========================

                EIZL = E * Iz / L
                EIZL2 = EIZL / L
                EIZL3 = EIZL2 / L
                EIWL = E * Iw / L
                EIWL2 = EIWL / L
                EIWL3 = EIWL2 / L

                'Influence du Taper Effect sur It
                If TaperEffect Then
                    It = It + E / G * Ipsi
                End If

                'K(I,J) (avec 7dof dont on ne garde que 4)
                If Not TaperEffect Then

                    'Sans influence du Taper Effect
                    K(2, 2) = 12 * EIZL3
                    K(2, 4) = 0
                    K(2, 6) = 6 * EIZL2
                    K(2, 7) = 0
                    K(2, 9) = -12 * EIZL3
                    K(2, 11) = 0
                    K(2, 13) = 6 * EIZL2
                    K(2, 14) = 0
                    K(4, 4) = 12 * EIWL3 + 6 * G * It / 5 / L
                    K(4, 6) = 0
                    K(4, 7) = 6 * EIWL2 + G * It / 10
                    K(4, 9) = 0
                    K(4, 11) = -12 * EIWL3 - 6 * G * It / 5 / L
                    K(4, 13) = 0
                    K(4, 14) = 6 * EIWL2 + G * It / 10
                    K(6, 6) = 4 * EIZL
                    K(6, 7) = 0
                    K(6, 9) = -6 * EIZL2
                    K(6, 11) = 0
                    K(6, 13) = 2 * EIZL
                    K(6, 14) = 0
                    K(7, 7) = 4 * EIWL + 2 * G * It * L / 15
                    K(7, 9) = 0
                    K(7, 11) = -6 * EIWL2 - G * It / 10
                    K(7, 13) = 0
                    K(7, 14) = 2 * EIWL - L * G * It / 30
                    K(9, 9) = 12 * EIZL3
                    K(9, 11) = 0
                    K(9, 13) = -6 * EIZL2
                    K(9, 14) = 0
                    K(11, 11) = 12 * EIWL3 + 6 * G * It / 5 / L
                    K(11, 13) = 0
                    K(11, 14) = -6 * EIWL2 - G * It / 10
                    K(13, 13) = 4 * EIZL
                    K(13, 14) = 0
                    K(14, 14) = 4 * EIWL + 2 * G * It * L / 15

                Else

                    'Avec influence du Taper Effect
                    K(2, 2) = 12 * EIZL3
                    K(2, 4) = -6 / 5 * E * Iz / L * zCs
                    K(2, 6) = 6 * EIZL2
                    K(2, 7) = (-E * Ipsiy / L - E * Iz * zCs / 10)
                    K(2, 9) = -12 * EIZL3
                    K(2, 11) = 6 / 5 * E * Iz / L * zCs
                    K(2, 13) = 6 * EIZL2
                    K(2, 14) = (E * Ipsiy / L - E * Iz * zCs / 10)
                    K(4, 4) = 12 * EIWL3 + 6 * G * It / 5 / L + 13 / 35 * E * Iz * L * zCs ^ 2 - E * Ipsiy * zCs
                    K(4, 6) = (E * Ipsiy / L - 11 * E * Iz * zCs / 10)
                    K(4, 7) = 6 * EIWL2 + G * It / 10 + (11 / 210 * E * Iz * zCs * zCs * L * L)
                    K(4, 9) = 6 / 5 * E * Iz / L * zCs
                    K(4, 11) = -12 * EIWL3 - 6 * G * It / 5 / L + (9 / 70 * E * Iz * zCs * zCs * L)
                    K(4, 13) = (-E * Ipsiy / L - E * Iz * zCs / 10)
                    K(4, 14) = 6 * EIWL2 + G * It / 10 - (13 / 420 * E * Iz * zCs * zCs * L * L)
                    K(6, 6) = 4 * EIZL
                    K(6, 7) = (-E * Ipsiy / 2 - 2 * E * Iz * zCs * L / 15)
                    K(6, 9) = -6 * EIZL2
                    K(6, 11) = (-E * Ipsiy / L + E * Iz * zCs / 10)
                    K(6, 13) = 2 * EIZL
                    K(6, 14) = (E * Ipsiy / 2 + E * Iz * zCs * L / 30)
                    K(7, 7) = 4 * EIWL + 2 * G * It * L / 15 - E * Iwpsi + 1 / 105 * E * Iz * zCs * zCs * L * L * L
                    K(7, 9) = (E * Ipsiy / L + E * Iz * zCs / 10)
                    K(7, 11) = -6 * EIWL2 - G * It / 10 + (13 / 420 * E * Iz * zCs * zCs * L * L)
                    K(7, 13) = (-E * Ipsiy / 2 + E * Iz * L * zCs / 30)
                    K(7, 14) = 2 * EIWL - L * G * It / 30 - 1 / 140 * E * Iz * zCs * zCs * L * L * L
                    K(9, 9) = 12 * EIZL3
                    K(9, 11) = -6 / 5 * E * Iz / L * zCs
                    K(9, 13) = -6 * EIZL2
                    K(9, 14) = (-E * Ipsiy / L + E * Iz * zCs / 10)
                    K(11, 11) = 12 * EIWL3 + 6 * G * It / 5 / L + 13 / 35 * E * Iz * zCs ^ 2 * L + E * Ipsiy * zCs
                    K(11, 13) = (E * Ipsiy / L + 11 * E * Iz * zCs / 10)
                    K(11, 14) = -6 * EIWL2 - G * It / 10 - 11 / 210 * E * Iz * zCs * zCs * L * L
                    K(13, 13) = 4 * EIZL
                    K(13, 14) = (E * Ipsiy / 2 - 2 * E * Iz * zCs / 15)
                    K(14, 14) = 4 * EIWL + 2 * G * It * L / 15 + (E * Iwpsi + 1 / 105 * E * Iz * zCs * zCs * L * L * L)

                End If

                'on rétablit It après prise en compte éventuelle du Taper Effect
                It = Itsave

        End Select


        'Correspondance entre SA(I) et K(I,J) (avec 7dof)
        SA(1) = K(2, 2)
        SA(2) = K(2, 4)
        SA(3) = K(4, 4)
        SA(4) = K(2, 6)
        SA(5) = K(4, 6)
        SA(6) = K(6, 6)
        SA(7) = K(2, 7)
        SA(8) = K(4, 7)
        SA(9) = K(6, 7)
        SA(10) = K(7, 7)
        SA(11) = K(2, 9)
        SA(12) = K(4, 9)
        SA(13) = K(6, 9)
        SA(14) = K(7, 9)
        SA(15) = K(9, 9)
        SA(16) = K(2, 11)
        SA(17) = K(4, 11)
        SA(18) = K(6, 11)
        SA(19) = K(7, 11)
        SA(20) = K(9, 11)
        SA(21) = K(11, 11)
        SA(22) = K(2, 13)
        SA(23) = K(4, 13)
        SA(24) = K(6, 13)
        SA(25) = K(7, 13)
        SA(26) = K(9, 13)
        SA(27) = K(11, 13)
        SA(28) = K(13, 13)
        SA(29) = K(2, 14)
        SA(30) = K(4, 14)
        SA(31) = K(6, 14)
