                    K(4, 9) = K(4, 9) - 6 / 5 * N / L * ZC + N * ZCP / 2
                    K(4, 11) = K(4, 11) - 6 / 5 * N / L * rYZ ^ 2 + 9 * N * L * ZCP ^ 2 / 70
                    K(4, 13) = K(4, 13) + 1 / 10 * N * ZC - L * N * ZCP / 10
                    K(4, 14) = K(4, 14) + 1 / 10 * N * rYZ ^ 2 - 13 * N * L ^ 2 * ZCP ^ 2 / 420
                    K(6, 6) = K(6, 6) + 2 / 15 * N * L
                    K(6, 7) = K(6, 7) + 2 / 15 * N * L * ZC
                    K(6, 9) = K(6, 9) - 1 / 10 * N
                    K(6, 11) = K(6, 11) - 1 / 10 * N * ZC - L * N * ZCP / 10
                    K(6, 13) = K(6, 13) - 1 / 30 * N * L
                    K(6, 14) = K(6, 14) - 1 / 30 * N * L * ZC + N * L ^ 2 * ZCP / 60
                    K(7, 7) = K(7, 7) + 2 / 15 * N * L * rYZ ^ 2 + N * L ^ 3 * ZCP ^ 2 / 105
                    K(7, 9) = K(7, 9) - 1 / 10 * N * ZC + L * N * ZCP / 10
                    K(7, 11) = K(7, 11) - 1 / 10 * N * rYZ ^ 2 + 13 * N * L ^ 2 * ZCP ^ 2 / 420
                    K(7, 13) = K(7, 13) - 1 / 30 * N * L * ZC - N * L ^ 2 * ZCP / 60
                    K(7, 14) = K(7, 14) - 1 / 30 * N * L * rYZ ^ 2 - N * L ^ 3 * ZCP ^ 2 / 140
                    K(9, 9) = K(9, 9) + 6 / 5 * N / L
                    K(9, 11) = K(9, 11) + 6 / 5 * N / L * ZC + N * ZCP / 2
                    K(9, 13) = K(9, 13) - 1 / 10 * N
                    K(9, 14) = K(9, 14) - 1 / 10 * N * ZC - L * N * ZCP / 10
                    K(11, 11) = K(11, 11) + 6 / 5 * N / L * rYZ ^ 2 + N * ZC * ZCP + 13 * N * L * ZCP ^ 2 / 35
                    K(11, 13) = K(11, 13) - 1 / 10 * N * ZC + L * N * ZCP / 10 'XXXX
                    K(11, 14) = K(11, 14) - 1 / 10 * N * rYZ ^ 2 - 11 * N * L ^ 2 * ZCP ^ 2 / 210
                    K(13, 13) = K(13, 13) + 2 / 15 * N * L
                    K(13, 14) = K(13, 14) + 2 / 15 * N * L * ZC
                    K(14, 14) = K(14, 14) + 2 / 15 * N * L * rYZ ^ 2 + N * L ^ 3 * ZCP ^ 2 / 105

                    '--> Termes dus à N liés à z'
                    K(2, 2) = K(2, 2) + 0
                    K(2, 4) = K(2, 4) + N * Izx / 2 / Aire
                    K(2, 6) = K(2, 6) + 0
                    K(2, 7) = K(2, 7) + N * L * Izx / 10 / Aire
                    K(2, 9) = K(2, 9) + 0
                    K(2, 11) = K(2, 11) + N * Izx / 2 / Aire
                    K(2, 13) = K(2, 13) + 0
                    K(2, 14) = K(2, 14) - N * L * Izx / 10 / Aire
                    K(4, 4) = K(4, 4) + 13 / 35 / Aire * N * L * Izx2 - 1 / Aire * N * Izzx + 1 / Aire * N * Izx * ZC - 26 / 35 / Aire * N * L * Izx * ZCP
                    K(4, 6) = K(4, 6) - N * L * Izx / 10 / Aire
                    K(4, 7) = K(4, 7) + 11 / 210 / Aire * N * L ^ 2 * Izx2 - 11 / 105 / Aire * N * L ^ 2 * Izx * ZCP
                    K(4, 9) = K(4, 9) - N * Izx / 2 / Aire
                    K(4, 11) = K(4, 11) + 9 / 70 / Aire * N * L * Izx2 - 9 / 35 / Aire * N * L * Izx * ZCP
                    K(4, 13) = K(4, 13) + N * L * Izx / 10 / Aire
                    K(4, 14) = K(4, 14) - 13 / 420 / Aire * N * L ^ 2 * Izx2 + 13 / 210 / Aire * N * L ^ 2 * Izx * ZCP
                    K(6, 6) = K(6, 6) + 0
                    K(6, 7) = K(6, 7) + 0
                    K(6, 9) = K(6, 9) + 0
                    K(6, 11) = K(6, 11) + N * L * Izx / 10 / Aire
                    K(6, 13) = K(6, 13) + 0
                    K(6, 14) = K(6, 14) - N * L ^ 2 * Izx / 60 / Aire
                    K(7, 7) = K(7, 7) + 1 / 105 / Aire * N * L ^ 3 * Izx2 - 2 / 105 / Aire * N * L ^ 3 * Izx * ZCP
                    K(7, 9) = K(7, 9) - N * L * Izx / 10 / Aire
                    K(7, 11) = K(7, 11) + 13 / 420 / Aire * N * L ^ 2 * Izx2 - 13 / 210 / Aire * N * L ^ 2 * Izx * ZCP
                    K(7, 13) = K(7, 13) - N * L ^ 2 * Izx / 60 / Aire
                    K(7, 14) = K(7, 14) - 1 / 140 / Aire * N * L ^ 3 * Izx2 + 1 / 70 / Aire * N * L ^ 3 * Izx * ZCP
                    K(9, 9) = K(9, 9) + 0
                    K(9, 11) = K(9, 11) - N * Izx / 2 / Aire
                    K(9, 13) = K(9, 13) + 0
                    K(9, 14) = K(9, 14) + N * L * Izx / 10 / Aire
                    K(11, 11) = K(11, 11) + 13 / 35 / Aire * N * L * Izx2 + 1 / Aire * N * Izzx - 1 / Aire * N * Izx * ZC - 26 / 35 / Aire * N * L * Izx * ZCP
                    K(11, 13) = K(11, 13) - N * L * Izx / 10 / Aire
                    K(11, 14) = K(11, 14) - 11 / 210 / Aire * N * L ^ 2 * Izx2 + 11 / 105 / Aire * N * L ^ 2 * Izx * ZCP
                    K(13, 13) = K(13, 13) + 0
                    K(13, 14) = K(13, 14) + 0
                    K(14, 14) = K(14, 14) + 1 / 105 / Aire * N * L ^ 3 * Izx2 - 2 / 105 / Aire * N * L ^ 3 * Izx * ZCP

                End If

        End Select

        '==================================================================================================================================
        'K(I,J) due aux charges en travées (avec 7dof dont on ne garde que 4)
        '==================================================================================================================================

        'termes dus aux F
        For nfe = 1 To NF
            F = Fe(nfe)
            ZF = ZFe(nfe)
            XF = XFe(nfe)
            If ZF <> 0 And F <> 0 Then
                K(4, 4) = K(4, 4) + ZF * F * (1 + 2 * XF) ^ 2 * (1 - XF) ^ 4
                K(4, 7) = K(4, 7) + ZF * F * XF * L * (1 + 2 * XF) * (1 - XF) ^ 4
                K(4, 11) = K(4, 11) + ZF * F * XF ^ 2 * (1 + 2 * XF) * (1 - XF) ^ 2 * (3 - 2 * XF)
                K(4, 14) = K(4, 14) - ZF * F * XF ^ 2 * L * (1 + 2 * XF) * (1 - XF) ^ 3
                K(7, 7) = K(7, 7) + ZF * F * XF ^ 2 * L ^ 2 * (1 - XF) ^ 4
                K(7, 11) = K(7, 11) + ZF * F * XF ^ 3 * L * (1 - XF) ^ 2 * (3 - 2 * XF)
                K(7, 14) = K(7, 14) - ZF * F * XF ^ 3 * L ^ 2 * (1 - XF) ^ 3
                K(11, 11) = K(11, 11) + ZF * F * XF ^ 4 * (3 - 2 * XF) ^ 2
                K(11, 14) = K(11, 14) - ZF * F * XF ^ 4 * L * (3 - 2 * XF) * (1 - XF)
                K(14, 14) = K(14, 14) + ZF * F * XF ^ 4 * L ^ 2 * (1 - XF) ^ 2
            End If
        Next nfe


        'termes dus aux q
        For nqe = 1 To NQ

            q1 = q1e(nqe)
            Xq1 = Xq1e(nqe)
            q2 = q2e(nqe)
            Xq2 = Xq2e(nqe)
            Zq = Zqe(nqe)

            If (q1 <> 0 Or q2 <> 0) And Xq2 - Xq1 > 0 Then

                QQ1 = (q1 * Xq2 - q2 * Xq1) / (Xq2 - Xq1)
                QQ2 = (q2 - q1) / (Xq2 - Xq1)

                K(4, 4) = K(4, 4) + Zq * L * QQ1 / 35 * Poly(Xq1, Xq2, 1, 35, 0, -70, 35, 63, -70, 20)
                K(4, 4) = K(4, 4) + Zq * L * QQ2 / 70 * Poly(Xq1, Xq2, 2, 35, 0, -105, 56, 105, -120, 35)

                K(4, 7) = K(4, 7) + Zq * L ^ 2 * QQ1 / 210 * Poly(Xq2, Xq1, 2, 105, -140, -105, 336, -245, 60, 0)
                K(4, 7) = K(4, 7) + Zq * L ^ 2 * QQ2 / 60 * Poly(Xq2, Xq1, 3, 20, -30, -24, 80, -60, 15, 0)

                K(4, 11) = K(4, 11) - Zq * L * QQ1 / 70 * Poly(Xq1, Xq2, 3, -70, 35, 126, -140, 40, 0, 0)
                K(4, 11) = K(4, 11) - Zq * L * QQ2 / 140 * Poly(Xq1, Xq2, 4, -105, 56, 210, -240, 70, 0, 0)

                K(4, 14) = K(4, 14) + Zq * L ^ 2 * QQ1 / 420 * Poly(Xq1, Xq2, 3, -140, 105, 252, -350, 120, 0, 0)
                K(4, 14) = K(4, 14) + Zq * L ^ 2 * QQ2 / 140 * Poly(Xq1, Xq2, 4, -35, 28, 70, -100, 35, 0, 0)

                K(7, 7) = K(7, 7) + Zq * L ^ 3 * QQ1 / 105 * Poly(Xq1, Xq2, 3, 35, -105, 126, -70, 15, 0, 0)
                K(7, 7) = K(7, 7) + Zq * L ^ 3 * QQ2 / 280 * Poly(Xq1, Xq2, 4, 70, -224, 280, -160, 35, 0, 0)

                K(7, 11) = K(7, 11) - Zq * L ^ 2 * QQ1 / 420 * Poly(Xq1, Xq2, 4, -315, 672, -490, 120, 0, 0, 0)
                K(7, 11) = K(7, 11) - Zq * L ^ 2 * QQ2 / 60 * Poly(Xq1, Xq2, 5, -36, 80, -60, 15, 0, 0, 0)

                K(7, 14) = K(7, 14) + Zq * L ^ 3 * QQ1 / 140 * Poly(Xq1, Xq2, 4, -35, 84, -70, 20, 0, 0, 0)
                K(7, 14) = K(7, 14) + Zq * L ^ 3 * QQ2 / 280 * Poly(Xq1, Xq2, 5, -56, 140, -120, 35, 0, 0, 0)

                K(11, 11) = K(11, 11) + Zq * L * QQ1 / 35 * Poly(Xq1, Xq2, 5, 63, -70, 20, 0, 0, 0, 0)
                K(11, 11) = K(11, 11) + Zq * L * QQ2 / 14 * Poly(Xq1, Xq2, 6, 21, -24, 7, 0, 0, 0, 0)

                K(11, 14) = K(11, 14) - Zq * L ^ 2 * QQ1 / 210 * Poly(Xq1, Xq2, 5, 126, -175, 60, 0, 0, 0, 0)
                K(11, 14) = K(11, 14) - Zq * L ^ 2 * QQ2 / 28 * Poly(Xq1, Xq2, 6, 14, -20, 7, 0, 0, 0, 0)

                K(14, 14) = K(14, 14) + Zq * L ^ 3 * QQ1 / 105 * Poly(Xq1, Xq2, 5, 21, -35, 15, 0, 0, 0, 0)
                K(14, 14) = K(14, 14) + Zq * L ^ 3 * QQ2 / 168 * Poly(Xq1, Xq2, 6, 28, -48, 21, 0, 0, 0, 0)

            End If

        Next nqe

        '==================================================================================================================================
        'Correspondance entre SB(I) et K(I,J) (avec 7 dof)
        'SB stockage triangulaire sup ou inf
        '==================================================================================================================================

        SB(1) = K(2, 2)
        SB(2) = K(2, 4)
        SB(3) = K(4, 4)
        SB(4) = K(2, 6)
        SB(5) = K(4, 6)
        SB(6) = K(6, 6)
        SB(7) = K(2, 7)
        SB(8) = K(4, 7)
        SB(9) = K(6, 7)
        SB(10) = K(7, 7)
        SB(11) = K(2, 9)
        SB(12) = K(4, 9)
        SB(13) = K(6, 9)
        SB(14) = K(7, 9)
