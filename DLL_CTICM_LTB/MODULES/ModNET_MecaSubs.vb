    Const RIGID As Double = 1.0E+30

    Sub MatRes(ByRef C() As Double, ByRef B() As Double)

        '     INTRODUCTION DES RESSORTS DANS MATRICE D'UNE BARRE (tiré de PEPWIN)   
        '***********************************************************************
        '      SUBROUTINE MATRES(IW,IDUMP,C,SBL,*)
        '***********************************************************************
        '                         -1
        '     CALCUL DE  C * (C+B)  * B        C= matrice diagonale des ressorts
        '                                      B= matrice sans les ressorts
        '
        '     On pose  A = C + B
        '                   -1
        '              U = A  * B     U calcul‚ en résolvant  A*U=B
        '
        '              A = L * LT
        '                                  on résoud L*Y=X   X=Bj
        '                                  on résoud LT*X=Y  Uj=X
        '              puis on calcule C*U
        '
        '     Les matrices A et B sont stockées triangulaires inférieures
        '     par lignes
        '***********************************************************************

        '      REAL*8    A(36),B(36),X(8),Y(8)

        Dim K, I, J, N As Short
        Dim NIM, IER As Short
        Dim EPS As Double

        N = 8
        NIM = N * (N + 1) / 2 '=36

        Dim x(8) As Double
        Dim Y(8) As Double
        Dim a(36) As Double

        '-CALCUL DE  A = C+B
        '-******************
        For I = 1 To NIM
            a(I) = B(I)
        Next I
        a(1) = B(1) + C(1)
        a(3) = B(3) + C(2)
        a(6) = B(6) + C(3)
        a(10) = B(10) + C(4)
        a(15) = B(15) + C(5)
        a(21) = B(21) + C(6)
        a(28) = B(28) + C(7)
        a(36) = B(36) + C(8)

        '-DECOMPOSITION DE CHOLESKI  A=L.LT  ===> L DANS A
        '-************************************************
        EPS = 0.00001
        Call CHOL(a, N, EPS, IER, NIM)
        If IER <> 0 Then 'erreur!
            Exit Sub
        End If

        '-RESOLUTION DE A*U=B
        '-*******************

        For J = N To 1 Step -1

            '-EXTRACTION DE LA COLONNE J DE B  ===> X
            If J <> 1 Then
                For I = 1 To J - 1
                    x(I) = B(IndL(J, I))
                Next I
            End If
            For I = J To N
                x(I) = B(IndL(I, J))
            Next I

            '-RESOLUTION DE  L.Y=X
            Y(1) = x(1) / a(1)
            For I = 2 To N
                Y(I) = x(I)
                For K = 1 To I - 1
                    Y(I) = Y(I) - a(IndL(I, K)) * Y(K)
                Next K
                Y(I) = Y(I) / a(IndL(I, I))
            Next I

            '-RESOLUTION DE  LT.X=Y   (X=colonne J de U)
            x(N) = Y(N) / a(IndL(N, N))
            For I = N - 1 To 1 Step -1
                x(I) = Y(I)
                For K = I + 1 To N
                    x(I) = x(I) - a(IndL(K, I)) * x(K)
                Next K
                x(I) = x(I) / a(IndL(I, I))
            Next I

            '-INSERTION DE X DANS COLONNE J DE B  (car U est stock‚e dans B)
            '-ET MULTIPLICATION PAR C   ( B=C*U)
            For I = J To N
                B(IndL(I, J)) = x(I) * C(I)
                If System.Math.Abs(B(IndL(I, J))) < 0.001 Then B(IndL(I, J)) = 0
            Next I

        Next J

    End Sub

